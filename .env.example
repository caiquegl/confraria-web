CONFRARIA_API_BASE_URL=https://sua-api.com
NEXT_PUBLIC_SITE_URL=https://confraria-web.vercel.app

# iOS Universal Links: TEAM_ID.bundleIdentifier
# Exemplo: ABC123DEF4.com.caiquegl22.appconfraria
APPLE_APP_ID=

# Android App Links: fingerprint SHA-256 do certificado usado no build.
# Separe múltiplos fingerprints por vírgula.
ANDROID_PACKAGE_NAME=com.caiquegl22.appconfraria
ANDROID_SHA256_CERT_FINGERPRINTS=
